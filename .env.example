# TaskFlow API Configuration
# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security - generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production. Development uses a warning-only fallback.
SECRET_KEY=your-secret-key-here

# Database - get the PostgreSQL URL from your provider (InsForge in production)
DATABASE_URL=postgresql://user:password@localhost:5432/taskflow
# prefer = local Postgres; require = InsForge/managed providers
DB_SSLMODE=prefer

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Account lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# CORS - comma-separated allowlist. Required in production.
# Development defaults to http://localhost:5173 and http://127.0.0.1:5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Connection pool
POOL_SIZE=10
MAX_OVERFLOW=20
POOL_PRE_PING=true

# Optional - Redis (rate limiting/cache when enabled)
# REDIS_URL=redis://localhost:6379/0

# Server-sent events (notifications)
# Delivery is event-driven (Redis pub/sub when REDIS_URL is reachable); the
# fallback poll reconciles missed events from the database.
SSE_FALLBACK_POLL_SECONDS=30
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_CONNECTIONS=500
SSE_MAX_CONNECTIONS_PER_USER=5

# Rate limiting (ADR-010)
# Empty RATE_LIMIT_STORAGE_URI reuses REDIS_URL so all API instances share
# counters. Set it to "memory://" for a single-process deployment.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=

# Optional - Sentry
# SENTRY_DSN=https://example@sentry.io/1234567
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Uploads
# database = stores bytes in PostgreSQL (persistent on Render)
# local    = writes to UPLOAD_DIR (development/tests)
# insforge = stores objects in the private InsForge Storage bucket
STORAGE_BACKEND=database
# Required only when STORAGE_BACKEND=insforge (server-only, never expose)
# INSFORGE_URL=https://<app-key>.<region>.insforge.app
# INSFORGE_API_KEY=ik_...
# INSFORGE_STORAGE_BUCKET=taskflow-attachments
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads
ALLOWED_UPLOAD_EXTENSIONS=png,jpg,jpeg,gif,webp,pdf,txt,csv,json,md,doc,docx,xls,xlsx,ppt,pptx,zip

# Retención de datos (Q-08): purga al arrancar y en scripts/purge_retention.py
NOTIFICATION_RETENTION_DAYS=90
ACTIVITY_RETENTION_DAYS=365
# Idempotencia: vigencia de las claves Idempotency-Key
IDEMPOTENCY_KEY_TTL_HOURS=24
