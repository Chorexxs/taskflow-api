# TaskFlow API Configuration
# Copy this file to .env and fill in the values

# Security - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Database - Get from InsForge dashboard
DATABASE_URL=the-password-to-your-database

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security - Account lockout settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Optional - Redis for caching (if using)
# REDIS_URL=redis://localhost:6379/0

# Optional - Sentry for error tracking
# SENTRY_DSN=https://example@sentry.io/1234567